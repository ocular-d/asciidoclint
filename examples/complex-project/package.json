{
  "name": "@asciidoclint/example-complex",
  "version": "1.0.0",
  "private": true,
  "description": "Complex example project with multiple document types",
  "scripts": {
    "test": "npm run test:api && npm run test:guides && npm run test:tutorials",
    "test:api": "adoc-lint docs/api/*.adoc --config configs/api.json",
    "test:guides": "adoc-lint docs/guides/*.adoc --config configs/guides.json",
    "test:tutorials": "adoc-lint docs/tutorials/*.adoc --config configs/tutorials.json",
    "lint:all": "adoc-lint docs/**/*.adoc"
  },
  "dependencies": {
    "@testthedocs/cli": "workspace:*",
    "@testthedocs/core": "workspace:*",
    "@testthedocs/rules-standard": "workspace:*"
  }
}