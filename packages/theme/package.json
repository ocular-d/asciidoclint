{
  "name": "@testthedocs/antora-theme",
  "description": "An archetype project that produces a UI for creating documentation sites with Antora",
  "homepage": "https://gitlab.com/antora/antora-ui-default",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/antora/antora-ui-default.git"
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "browserslist": [
    "last 2 versions"
  ],
  "scripts": {
    "build": "vite build",
    "bundle": "vite build && node scripts/build-vendor.mjs",
    "dev": "vite",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint src/js",
    "lint:css": "stylelint \"src/css/**/*.css\""
  },
  "devDependencies": {
    "@fontsource/roboto": "~5.2.10",
    "@fontsource/roboto-mono": "~5.2.8",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "autoprefixer": "~10.4.27",
    "cssnano": "~7.1.3",
    "eslint": "~9.37.0",
    "eslint-plugin-import": "~2.32.0",
    "eslint-plugin-n": "~17.24.0",
    "eslint-plugin-promise": "~7.2.1",
    "highlight.js": "11.11.1",
    "postcss-calc": "~10.1.1",
    "postcss-custom-properties": "~15.0.1",
    "postcss-import": "~16.1.1",
    "stylelint": "~16.25.0",
    "stylelint-config-standard": "~39.0.0",
    "terser": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^3.0.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "simple-datatables": "^10.2.0",
    "tailwindcss": "^4.2.2"
  }
}
