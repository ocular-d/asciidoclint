<article class="doc max-w-full overflow-x-hidden">
{{#with page.title}}
<h1 class="page">{{{this}}}</h1>
{{/with}}
{{#if (ne page.layout 'subsection')}}
{{!-- {{> article-info-bar}} --}}
{{/if}}
{{{page.contents}}}
{{#if (and (ne page.layout '404') (ne page.layout 'subsection'))}}
{{> page-pagination}}
{{/if}}
</article>
