{
  "name": "@testthedocs/rules-standard",
  "version": "1.0.0",
  "description": "Standard rules for AsciiDoc linting",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "asciidoc",
    "linter",
    "rules",
    "documentation"
  ],
  "author": "OCLD Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ocld/asciidoclint.git",
    "directory": "packages/rules-standard"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@testthedocs/core": "workspace:*",
    "debug": "^4.4.3"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^25.5.0",
    "jest": "^30.3.0",
    "typescript": "^6.0.2"
  }
}