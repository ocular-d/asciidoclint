{
  "name": "@testthedocs/cli",
  "version": "1.0.0",
  "description": "Command-line interface for AsciiDoc linting",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "adoc-lint": "./bin/cli.js"
  },
  "scripts": {
    "build": "tsc && chmod +x bin/cli.js",
    "dev": "tsc --watch",
    "test": "jest --passWithNoTests",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "keywords": [
    "asciidoc",
    "linter",
    "cli",
    "documentation"
  ],
  "author": "OCLD Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ocld/asciidoclint.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@testthedocs/core": "workspace:*",
    "@testthedocs/rules-standard": "workspace:*",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "glob": "^10.3.10",
    "debug": "^4.3.4"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "typescript": "^5.9.3",
    "@types/node": "^25.1.0",
    "jest": "^30.2.0"
  }
}