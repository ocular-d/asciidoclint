{
  "name": "@testthedocs/cli",
  "version": "1.0.0",
  "description": "Command-line interface for AsciiDoc linting",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "bin": {
    "adoc-lint": "./bin/cli.js"
  },
  "scripts": {
    "build": "tsc && chmod +x bin/cli.js",
    "dev": "tsc --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "keywords": [
    "asciidoc",
    "linter",
    "cli",
    "documentation"
  ],
  "author": "OCLD Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ocld/asciidoclint.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "name": "@testthedocs/asciidoc-linter",
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@testthedocs/core": "workspace:*",
    "@testthedocs/rules-standard": "workspace:*",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "debug": "^4.4.3",
    "glob": "^13.0.6"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^25.5.0",
    "jest": "^30.3.0",
    "typescript": "^6.0.2"
  }
}