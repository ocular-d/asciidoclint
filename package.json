{
    "name": "@testthedocs/asciidoc-linter-workspace",
    "version": "0.1.0",
    "description": "AsciiDoc linter workspace with documentation and theme",
    "license": "MIT",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "pnpm -r run build",
        "test": "pnpm -r run test",
        "dev": "pnpm -r run dev",
        "clean": "pnpm -r run clean",
        "lint": "pnpm -r run lint",
        "linter:start": "pnpm --filter @testthedocs/asciidoc-linter run start",
        "docs:build": "pnpm --filter @testthedocs/docs run build",
        "docs:dev": "pnpm --filter @testthedocs/docs run dev",
        "theme:build": "pnpm --filter @testthedocs/antora-theme run build",
        "theme:dev": "pnpm --filter @testthedocs/antora-theme run dev"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "typescript": "^5.0.0"
    },
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=8.0.0"
    }
}
