{
  "name": "asciidoclint-workspace",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "lint": "eslint . --ext .ts,.js",
    "type-check": "pnpm -r run type-check",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "docs:api": "pnpm docs:api:core && pnpm docs:api:cli && pnpm docs:api:rules",
    "docs:api:core": "cd packages/core && typedoc",
    "docs:api:cli": "cd packages/cli && typedoc",
    "docs:api:rules": "cd packages/rules-standard && typedoc",
    "docs:theme": "pnpm --filter @testthedocs/antora-theme build",
    "docs:site": "pnpm --filter @testthedocs/docs build",
    "docs:serve": "pnpm --filter @testthedocs/docs serve",
    "docs:build": "pnpm docs:api && pnpm docs:theme && pnpm docs:site",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "validate-release": "node scripts/validate-release.js",
    "test-published": "node scripts/test-published-package.js",
    "promote-release": "node scripts/promote-release.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@testthedocs/antora-theme": "workspace:*",
    "@testthedocs/docs": "workspace:*",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "execa": "^9.6.1",
    "jest": "^30.3.0",
    "prettier": "^3.8.1",
    "semver": "^7.7.4",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.2"
  }
}